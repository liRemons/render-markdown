{
  "name": "remons-render-markdown",
  "version": "1.0.27-beta.12",
  "description": "一个基于 React 的 Markdown 渲染组件，支持 GFM（GitHub Flavored Markdown）、代码高亮、Mermaid 图表、Tabs 渲染等功能。",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:analyze": "vite-bundle-visualizer --output dist/stats.html --open",
    "dev": "vite",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "markdown",
    "react",
    "render",
    "gfm",
    "mermaid"
  ],
  "author": "remons",
  "license": "MIT",
  "peerDependencies": {
    "@ant-design/icons": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@ant-design/icons": {
      "optional": false
    }
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@changesets/cli": "^2.27.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^8.0.0",
    "less": "^4.2.0",
    "prettier": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "terser": "^5.50.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-dts": "^4.0.0"
  },
  "dependencies": {
    "@mdit/plugin-alert": "^2.0.0",
    "@mdit/plugin-tab": "^2.0.0",
    "@panzoom/panzoom": "^4.6.2",
    "classnames": "^2.5.1",
    "driver.js": "^1.8.0",
    "highlight.js": "^11.12.0",
    "lodash.clonedeep": "^4.5.0",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-toc-done-right": "^4.2.0",
    "methods-r": "^2.0.0-rc.1",
    "viewerjs": "^1.11.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liRemons/render-markdown.git"
  }
}
